configfile: "/mnt/data/bioinfoteam/Betty/malpipeline/data/config.yaml"
reference_fasta=config["reference_fasta"]
#prefix=config["prefix"]

(SAMPLES,)=glob_wildcards("/mnt/data/bioinfoteam/Betty/malpipeline/data/fastq/{sample}_R1_001.fastq.gz")

ruleorder: bbduk > bowtie > tobam > samtools_sort > index > call_vcf > liftover  > annotate > extract_snpeff_info

#onstart:
#    "Rscript scripts/initialise.R"


rule all:
    input:
        expand("/mnt/data/bioinfoteam/Betty/malpipeline/results/ann3/{sample}.csv", sample=SAMPLES)

rule bbduk:
    input:
        fwd="/mnt/data/bioinfoteam/Betty/malpipeline/data/fastq/{sample}_R1_001.fastq.gz",
        rev="/mnt/data/bioinfoteam/Betty/malpipeline/data/fastq/{sample}_R2_001.fastq.gz"
    output:
        fwd="/mnt/data/bioinfoteam/Betty/malpipeline/results/trimmed/{sample}_R1_trimmed.fastq.gz",
        rev="/mnt/data/bioinfoteam/Betty/malpipeline/results/trimmed/{sample}_R2_trimmed.fastq.gz",
        stat="/mnt/data/bioinfoteam/Betty/malpipeline/results/trimmed/{sample}_stats.txt"
    shell:
        "/mnt/data/bioinfoteam/Betty/anaconda3b/envs/mala/bin/bbduk.sh    trimq=20 maq=20 minlength=100  ordered=t  in={input.fwd} in2={input.rev} out={output.fwd} out2={output.rev} stats={output.stat}"


rule bowtie:
    input:
        fwd="/mnt/data/bioinfoteam/Betty/malpipeline/results/trimmed/{sample}_R1_trimmed.fastq.gz",
        rev="/mnt/data/bioinfoteam/Betty/malpipeline/results/trimmed/{sample}_R2_trimmed.fastq.gz"
    output:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/bam/{sample}_aln.sam"
    shell:
        " bowtie2 --very-sensitive  --end-to-end   -x /mnt/data/bioinfoteam/Betty/malpipeline/data/reference/refs_all_index -1 {input.fwd} -2 {input.rev} -p 8 -S {output}"


rule tobam:
    input:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/bam/{sample}_aln.sam"
    output:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/bam/{sample}_aln.bam"
    shell:
        "samtools view -b {input} -o {output}"


rule samtools_sort:
    input:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/bam/{sample}_aln.bam"
    output:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/bam/{sample}.sorted.bam"
    shell:
        "samtools sort {input} -o {output}"

rule index:
    input:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/bam/{sample}.sorted.bam"
    output:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/bam/{sample}.sorted.bai"
    shell:
        "samtools index {input}"

rule pileup_and_cons:
    input:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/bam/{sample}.sorted.bam"
    output:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/consensus/{sample}.fa"
    shell:
        "samtools mpileup  -A -d 8000 -B -Q 0 --reference {reference_fasta}  {input} | ivar consensus -p {output}"

rule coverage:
    input:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/bam/{sample}.sorted.bam"
    output:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/stat/{sample}_coverage.txt"
    shell:
        "samtools flagstat {input} "

rule depth:
    input:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/bam/{sample}.sorted.bam"
    output:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/stat/{sample}_depth.txt"
    shell:
        "samtools depth {input} | awk '{sum+=$3} END { print sum/NR }' "


rule call_vcf:
    input:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/bam/{sample}.sorted.bam"
    output:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/vcf/{sample}.vcf"
    shell:
        "bcftools mpileup  -f {reference_fasta}  {input} | bcftools call -vm > {output}"

rule liftover:
    input:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/vcf/{sample}.vcf"
    output:
        "/mnt/data/bioinfoteam/Betty/malpipeline/results/vcf/a{sample}.vcf"
    params:
        script="/mnt/data/bioinfoteam/Betty/scripts/adjust2.py"

    shell:
        """
        sed -i 's;PfMDR1;5;'g {input}
        sed -i 's;K13;13;'g {input}
        sed -i 's;DHFR;4;'g {input}
        sed -i 's;DHPS;8;'g {input}
        sed -i 's;PfCRT;7;'g {input}
        python {params.script} {input} > {output} 
        """

