#       cd  {params.snake_dir}
#       """

rule annotate:
    input:
        vcf="/mnt/data/bioinfoteam/Betty/malpipeline/results/vcf/a{sample}.vcf",
        snpeff_jar="/mnt/data/bioinfoteam/Betty/snpEff/snpEff.jar",
        snpeff_database="/mnt/data/bioinfoteam/Betty/snpEff/data/Plasmodium_falciparum_3",
        snpeff_config="/mnt/data/bioinfoteam/Betty/snpEff/custom.config",
        snpeff_datadir="/mnt/data/bioinfoteam/Betty/snpEff/data",
#       pwd="/mnt/data/bioinfoteam/Betty/malpipeline/results/pwd.txt"
    params:
        working_dir="/mnt/data/bioinfoteam/Betty/snpEff",
        snake_dir="/mnt/data/bioinfoteam/Betty/malpipeline/snake",
        tmp="/mnt/data/bioinfoteam/Betty/tmpall/"
    output:
        ann="/mnt/data/bioinfoteam/Betty/malpipeline/results/ann3/{sample}.ann"
    shell:
       """
       cd  {params.working_dir}
       java -Djava.io.tmpdir=/mnt/data/bioinfoteam/Betty/tmpall/ -Xmx20G -jar /mnt/data/bioinfoteam/Betty/snpEff/snpEff.jar -c {input.snpeff_config}  Plasmodium_falciparum_3  -debug  {input.vcf} > {output}
       cd  {params.snake_dir}
       """

rule extract_snpeff_info:
    input:
#        expand("/mnt/data/bioinfoteam/Betty/malpipeline/results/ann3/{sample}.ann", sample=SAMPLES)
        ann="/mnt/data/bioinfoteam/Betty/malpipeline/results/ann3/{sample}.ann"
    output:
        csv="/mnt/data/bioinfoteam/Betty/malpipeline/results/ann3/{sample}.csv"
    params:
        output_dir="/mnt/data/bioinfoteam/Betty/malpipeline/results/ann3"
#    script:
#        "/mnt/data/bioinfoteam/Betty/malpipeline/scripts/anntocsv.py"
    shell:
        "python /mnt/data/bioinfoteam/Betty/malpipeline/scripts/anntocsv.py {input.ann} {output.csv}"


