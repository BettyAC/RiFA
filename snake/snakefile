rule annotate:
    input:
        vcf=f"{RESULTS}/vcf/a{{sample}}.vcf",
        snpeff_jar=f"{HOME}/resources/snpEff/snpEff.jar",
        snpeff_database=f"{HOME}/resources/snpEff/data/Plasmodium_falciparum_1",
        snpeff_config=f"{HOME}/resources/snpEff/snpEff.config",
        snpeff_datadir=f"{HOME}/resources/snpEff/data"
#       pwd="results/pwd.txt"
    params:
        working_dir=f"{HOME}/resources/snpEff",
        snake_dir=f"{HOME}/snake"
#       tmp="tmp/"
    output:
        ann=f"{RESULTS}/ann/{{sample}}.ann"
    shell:
       """
       cd  {params.working_dir}
       java -Xmx20G -jar {HOME}/snpEff/snpEff.jar -c {input.snpeff_config}  Plasmodium_falciparum_1  -debug  {input.vcf} > {output}
       cd  {params.snake_dir}
       """

rule extract_snpeff_info:
    input:
#        expand("results/ann/{sample}.ann", sample=SAMPLES)
        ann=f"{RESULTS}/ann/{{sample}}.ann"
    output:
        csv=f"{RESULTS}/ann/{{sample}}.csv"
    params:
        output_dir=f"{HOME}/results/ann"
#    script:
#        "scripts/anntocsv.py"
    shell:
        "python {HOME}/scripts/anntocsv.py {input.ann} {output.csv}"


