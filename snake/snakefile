configfile: "/home/betty/rifa/data/config.yaml"
reference_fasta=config["reference_fasta"]
#prefix=config["prefix"]

import os
from snakemake.io import glob_wildcards

# Define directories and samples (portable)
DATA = os.path.expanduser("~/rifa/data/fastq")
RESULTS = os.path.expanduser("~/rifa/results")
HOME = os.path.expanduser("~/rifa")

(SAMPLES,) = glob_wildcards(f"{DATA}/{{sample}}_R1_001.fastq.gz")


#(SAMPLES,)=glob_wildcards("~/rifa/data/fastq/{sample}_R1_001.fastq.gz")

ruleorder: bbduk > bowtie > tobam > samtools_sort > index > call_vcf > liftover  > annotate > extract_snpeff_info

#onstart:
#    "Rscript scripts/initialise.R"


rule all:
    input:
        expand(f"{RESULTS}/ann/{{sample}}.csv", sample=SAMPLES)

rule bbduk:
    input:
        fwd=f"{DATA}/{{sample}}_R1_001.fastq.gz",
        rev=f"{DATA}/{{sample}}_R2_001.fastq.gz"
    output:
        fwd=f"{RESULTS}/trimmed/{{sample}}_R1_trimmed.fastq.gz",
        rev=f"{RESULTS}/trimmed/{{sample}}_R2_trimmed.fastq.gz",
        stat=f"{RESULTS}/trimmed/{{sample}}_stats.txt"
    shell:
        " {HOME}/resources/bbmap/bbduk.sh  threads=1  trimq=20 maq=20 minlength=100  ordered=t  in={input.fwd} in2={input.rev} out={output.fwd} out2={output.rev} stats={output.stat}"


rule bowtie:
    input:
        fwd=f"{RESULTS}/trimmed/{{sample}}_R1_trimmed.fastq.gz",
        rev=f"{RESULTS}/trimmed/{{sample}}_R2_trimmed.fastq.gz"
    output:
        f"{RESULTS}/bam/{{sample}}_aln.sam"
    shell:
        " bowtie2 --very-sensitive  --end-to-end   -x {DATA}/reference/malref6_index -1 {input.fwd} -2 {input.rev} -p 8 -S {output}"


rule tobam:
    input:
        f"{RESULTS}/bam/{{sample}}_aln.sam"
    output:
        f"{RESULTS}/bam/{{sample}}_aln.bam"
    shell:
        "samtools view -b {input} -o {output}"


rule samtools_sort:
    input:
        f"{RESULTS}/bam/{{sample}}_aln.bam"
    output:
        f"{RESULTS}/bam/{{sample}}.sorted.bam"
    shell:
        "samtools sort {input} -o {output}"

rule index:
    input:
        f"{RESULTS}/bam/{{sample}}.sorted.bam"
    output:
        f"{RESULTS}/bam/{{sample}}.sorted.bai"
    shell:
        "samtools index {input}"

rule pileup_and_cons:
    input:
        f"{RESULTS}/bam/{{sample}}.sorted.bam"
    output:
        f"{RESULTS}/consensus/{{sample}}.fa"
    shell:
        "samtools mpileup  -A -d 8000 -B -Q 0 --reference {reference_fasta}  {input} | ivar consensus -p {output}"

rule coverage:
    input:
        f"{RESULTS}/bam/{{sample}}.sorted.bam"
    output:
        f"{RESULTS}/stat/{{sample}}_coverage.txt"
    shell:
        "samtools flagstat {input} "

rule depth:
    input:
        f"{RESULTS}/bam/{{sample}}.sorted.bam"
    output:
        f"{RESULTS}/stat/{{sample}}_depth.txt"
    shell:
        "samtools depth {input} | awk '{sum+=$3} END { print sum/NR }' "


rule call_vcf:
    input:
        f"{RESULTS}/bam/{{sample}}.sorted.bam"
    output:
        f"{RESULTS}/vcf/{{sample}}.vcf"
    shell:
        "bcftools mpileup  -f {reference_fasta}  {input} | bcftools call -vm > {output}"

rule liftover:
    input:
        f"{RESULTS}/vcf/{{sample}}.vcf"
    output:
        f"{RESULTS}/vcf/a{{sample}}.vcf"
    params:
        script=f"{HOME}/scripts/adjust2.py"

    shell:
        """
        sed -i 's;PfMDR1;5;'g {input}
        sed -i 's;K13;13;'g {input}
        sed -i 's;DHFR;4;'g {input}
        sed -i 's;DHPS;8;'g {input}
        sed -i 's;PfCRT;7;'g {input}
        python {params.script} {input} > {output} 
        """

