configfile: "data/config.yaml"
reference_fasta=config["reference_fasta"]
#prefix=config["prefix"]

(SAMPLES,)=glob_wildcards("data/fastq/{sample}_R1_001.fastq.gz")

ruleorder: bbduk > bowtie > tobam > samtools_sort > index > call_vcf > liftover  > annotate > extract_snpeff_info

#onstart:
#    "Rscript scripts/initialise.R"


rule all:
    input:
        expand("results/ann/{sample}.csv", sample=SAMPLES)

rule bbduk:
    input:
        fwd="data/fastq/{sample}_R1_001.fastq.gz",
        rev="data/fastq/{sample}_R2_001.fastq.gz"
    output:
        fwd="results/trimmed/{sample}_R1_trimmed.fastq.gz",
        rev="results/trimmed/{sample}_R2_trimmed.fastq.gz",
        stat="results/trimmed/{sample}_stats.txt"
    shell:
        "resources/bbduk.sh    trimq=20 maq=20 minlength=100  ordered=t  in={input.fwd} in2={input.rev} out={output.fwd} out2={output.rev} stats={output.stat}"


rule bowtie:
    input:
        fwd="results/trimmed/{sample}_R1_trimmed.fastq.gz",
        rev="results/trimmed/{sample}_R2_trimmed.fastq.gz"
    output:
        "results/bam/{sample}_aln.sam"
    shell:
        " bowtie2 --very-sensitive  --end-to-end   -x data/reference/malref6_index -1 {input.fwd} -2 {input.rev} -p 8 -S {output}"


rule tobam:
    input:
        "results/bam/{sample}_aln.sam"
    output:
        "results/bam/{sample}_aln.bam"
    shell:
        "samtools view -b {input} -o {output}"


rule samtools_sort:
    input:
        "results/bam/{sample}_aln.bam"
    output:
        "results/bam/{sample}.sorted.bam"
    shell:
        "samtools sort {input} -o {output}"

rule index:
    input:
        results/bam/{sample}.sorted.bam"
    output:
        "results/bam/{sample}.sorted.bai"
    shell:
        "samtools index {input}"

rule pileup_and_cons:
    input:
        "results/bam/{sample}.sorted.bam"
    output:
        "results/consensus/{sample}.fa"
    shell:
        "samtools mpileup  -A -d 8000 -B -Q 0 --reference {reference_fasta}  {input} | ivar consensus -p {output}"

rule coverage:
    input:
        results/bam/{sample}.sorted.bam"
    output:
        "results/stat/{sample}_coverage.txt"
    shell:
        "samtools flagstat {input} "

rule depth:
    input:
        "results/bam/{sample}.sorted.bam"
    output:
        "results/stat/{sample}_depth.txt"
    shell:
        "samtools depth {input} | awk '{sum+=$3} END { print sum/NR }' "


rule call_vcf:
    input:
        "results/bam/{sample}.sorted.bam"
    output:
        "results/vcf/{sample}.vcf"
    shell:
        "bcftools mpileup  -f {reference_fasta}  {input} | bcftools call -vm > {output}"

rule liftover:
    input:
        "results/vcf/{sample}.vcf"
    output:
        "results/vcf/a{sample}.vcf"
    params:
        script="scripts/adjust2.py"

    shell:
        """
        sed -i 's;PfMDR1;5;'g {input}
        sed -i 's;K13;13;'g {input}
        sed -i 's;DHFR;4;'g {input}
        sed -i 's;DHPS;8;'g {input}
        sed -i 's;PfCRT;7;'g {input}
        python {params.script} {input} > {output} 
        """

#rule build:
#    input:
