rule annotate:
    input:
        vcf="results/vcf/a{sample}.vcf",
        snpeff_jar="resources/snpEff/snpEff.jar",
        snpeff_database="resources/snpEff/data/Plasmodium_falciparum_3",
        snpeff_config="resources/snpEff/custom.config",
        snpeff_datadir="resources/snpEff/data",
#       pwd="results/pwd.txt"
    params:
        working_dir="resources/snpEff",
        snake_dir="snake",
#       tmp="tmp/"
    output:
        ann="results/ann/{sample}.ann"
    shell:
       """
       cd  {params.working_dir}
       java -Xmx20G -jar snpEff/snpEff.jar -c {input.snpeff_config}  Plasmodium_falciparum_1  -debug  {input.vcf} > {output}
       cd  {params.snake_dir}
       """

rule extract_snpeff_info:
    input:
#        expand("results/ann/{sample}.ann", sample=SAMPLES)
        ann="results/ann/{sample}.ann"
    output:
        csv="results/ann/{sample}.csv"
    params:
        output_dir="results/ann"
#    script:
#        "scripts/anntocsv.py"
    shell:
        "python scripts/anntocsv.py {input.ann} {output.csv}"


